{
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit",
        "source.sortMembers": "explicit"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "keyword.other.dotenv",
                "settings": {
                    "foreground": "#FF000000"
                }
            }
        ],
        "comments": ""
    },
    "files.exclude": {
        "app/index.jsx": true,
        ".annotations": true,
        ".expo": true,
        ".idea": true,
        "**/node_modules": true
    }
}